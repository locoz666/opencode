FROM oven/bun:1.3.10 AS build

WORKDIR /app

ENV HUSKY=0

COPY package.json bun.lock ./
COPY patches patches/
COPY packages/app/package.json packages/app/package.json
COPY packages/sdk/js/package.json packages/sdk/js/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/util/package.json packages/util/package.json
COPY packages/slack/package.json packages/slack/package.json

RUN bun install --frozen-lockfile

COPY packages/app packages/app
COPY packages/sdk/js packages/sdk/js
COPY packages/ui packages/ui
COPY packages/util packages/util

RUN bun run --cwd packages/app build

FROM nginx:1.29-alpine

COPY packages/app/nginx.conf /etc/nginx/nginx.conf.template
COPY --from=build /app/packages/app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["/bin/sh", "-c", "export DNS_RESOLVER=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf) && envsubst '$DNS_RESOLVER' </etc/nginx/nginx.conf.template >/etc/nginx/nginx.conf && exec nginx -g 'daemon off;'"]
